chip soc/intel/alderlake
	# FSP configuration

	# Enable CNVi BT
	register "cnvi_bt_core" = "true"

	# Sagv Configuration
	register "sagv" = "SaGv_Enabled"

	# TCSS USB3
	register "tcss_aux_ori" = "5"
	register "typec_aux_bias_pads[0]" = "{.pad_auxp_dc = GPP_B23, .pad_auxn_dc = GPP_B7}"
	register "typec_aux_bias_pads[1]" = "{.pad_auxp_dc = GPP_D15, .pad_auxn_dc = GPP_D4}"

	register "s0ix_enable" = "!CONFIG_WDT_ENABLE"

	register "serial_io_i2c_mode" = "{
		[PchSerialIoIndexI2C0] = PchSerialIoPci,
		[PchSerialIoIndexI2C1] = PchSerialIoDisabled,
		[PchSerialIoIndexI2C2] = PchSerialIoDisabled,
		[PchSerialIoIndexI2C3] = PchSerialIoDisabled,
		[PchSerialIoIndexI2C4] = PchSerialIoDisabled,
		[PchSerialIoIndexI2C5] = PchSerialIoDisabled,
	}"

	# Intel Common SoC config
	register "common_soc_config" = "{
		.i2c[0] = {
			.speed = I2C_SPEED_FAST,
		},
	}"

	# HD Audio
	register "pch_hda_dsp_enable" = "1"
	register "pch_hda_idisp_link_tmode" = "HDA_TMODE_8T"
	register "pch_hda_idisp_link_frequency" = "HDA_LINKFREQ_96MHZ"
	register "pch_hda_idisp_codec_enable" = "1"

	register "cnvi_bt_audio_offload" = "true"

	device domain 0 on
		device ref igpu on
			register "ddi_ports_config" = "{
				[DDI_PORT_1] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
				[DDI_PORT_2] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
			}"
		end
		device ref gna on end
		device ref crashlog off end
		device ref xhci on
			# USB Type-C Port 1
			register "usb2_ports[0]" = "USB2_PORT_MID(OC1)"
			register "tcss_ports[0]" = "TCSS_PORT_DEFAULT(OC1)"

			# USB Type-C Port 2
			register "usb2_ports[4]" = "USB2_PORT_MID(OC1)"
			register "tcss_ports[1]" = "TCSS_PORT_DEFAULT(OC1)"

			# M.2 Key B (WWAN) Socket
			register "usb2_ports[1]" = "USB2_PORT_MID(OC_SKIP)"
			register "usb3_ports[3]" = "USB3_PORT_DEFAULT(OC_SKIP)"

			# M-Bus
			register "usb2_ports[3]" = "USB2_PORT_MID(OC_SKIP)"

			# CNVi Bluetooth
			register "usb2_ports[9]" = "USB2_PORT_MID(OC_SKIP)"

			chip drivers/usb/acpi
				device ref xhci_root_hub on
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C Port 1""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref usb2_port1 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C Port 2""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref usb2_port5 on end
					end
				end
			end
		end
		device ref shared_sram on end
		device ref hda on end
		device ref tcss_xhci on
			chip drivers/usb/acpi
				device ref tcss_root_hub on
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C Port 1""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref tcss_usb3_port1 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C Port 2""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref tcss_usb3_port2 on end
					end
				end
			end
		end
		device ref pmc hidden
			# The pmc_mux chip driver is a placeholder for the
			# PMC.MUX device in the ACPI hierarchy.
			chip drivers/intel/pmc_mux
				device generic 0 on
					chip drivers/intel/pmc_mux/conn
						use usb2_port1 as usb2_port
						use tcss_usb3_port1 as usb3_port
						device generic 0 alias conn0 on end
					end
					chip drivers/intel/pmc_mux/conn
						use usb2_port5 as usb2_port
						use tcss_usb3_port2 as usb3_port
						device generic 1 alias conn1 on end
					end
				end
			end
		end
		device ref sata on
			register "sata_salp_support" = "1"
			register "sata_ports_enable[1]" = "1"
			register "sata_ports_dev_slp[1]" = "1"
		end
		device ref cnvi_wifi on
			chip drivers/wifi/generic
				register "wake" = "GPE0_PME_B0"
				device generic 0 on end
			end
		end

		# LAN1 (I226)
		device ref pcie_rp1 on
			register "pch_pcie_rp[PCH_RP(1)]" = "{
				.clk_src = 4,
				.clk_req = 4,
				.flags = PCIE_RP_LTR | PCIE_RP_AER | PCIE_RP_BUILT_IN,
			}"
			chip soc/intel/common/block/pcie/rtd3
				register "enable_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_E5)"
				register "reset_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_A7)"
				register "srcclk_pin" = "4"
				device generic 0 on
				end
			end
		end

		# LAN0 (I226)
		device ref pcie_rp2 on
			register "pch_pcie_rp[PCH_RP(2)]" = "{
				.clk_src = 3,
				.clk_req = 3,
				.flags = PCIE_RP_LTR | PCIE_RP_AER | PCIE_RP_BUILT_IN,
			}"
			chip soc/intel/common/block/pcie/rtd3
				register "enable_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_E4)"
				register "reset_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_H23)"
				register "srcclk_pin" = "3"
				device generic 0 on
				end
			end
		end

		# LAN2 (I210)
		device ref pcie_rp3 on
			register "pch_pcie_rp[PCH_RP(3)]" = "{
				.clk_src = 2,
				.clk_req = 2,
				.flags = PCIE_RP_LTR | PCIE_RP_AER | PCIE_RP_BUILT_IN,
			}"
			chip soc/intel/common/block/pcie/rtd3
				register "enable_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_D16)"
				register "reset_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_E15)"
				register "srcclk_pin" = "2"
				device generic 0 on
				end
			end
		end

		# M.2 WWAN
		device ref pcie_rp7 on
			register "pch_pcie_rp[PCH_RP(7)]" = "{
				.clk_src = 1,
				.clk_req = 1,
				.flags = PCIE_RP_LTR | PCIE_RP_AER,
				.pcie_rp_detect_timeout_ms = 50,
			}"
			smbios_slot_desc "SlotTypeM2Socket2" "SlotLengthOther" "M.2/B 2242" "SlotDataBusWidth1X"
			chip soc/intel/common/block/pcie/rtd3
				register "reset_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_F16)"
				register "reset_off_delay_ms" = "20"
				register "srcclk_pin" = "1"
				register "ext_pm_support" = "ACPI_PCIE_RP_EMIT_ALL"
				register "skip_on_off_support" = "true"
				register "use_rp_mutex" = "true"
				device generic 0 alias rp7_rtd3 on
				end
			end
			chip drivers/wwan/fm
				register "fcpo_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_F15)"
				register "reset_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_F12)"
				register "perst_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_F16)"
				register "add_acpi_dma_property" = "true"
				use rp7_rtd3 as rtd3dev
				device generic 0 on end
			end
		end

		# M.2 Key M
		device ref pcie_rp9 on
			register "pch_pcie_rp[PCH_RP(9)]" = "{
				.clk_src = 0,
				.clk_req = 0,
				.flags = PCIE_RP_LTR | PCIE_RP_AER,
				.pcie_rp_detect_timeout_ms = 50,
			}"
			smbios_slot_desc "SlotTypeM2Socket3" "SlotLengthOther" "M.2/M 2280" "SlotDataBusWidth4X"
			chip soc/intel/common/block/pcie/rtd3
				register "enable_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_E11)"
				register "reset_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_E16)"
				register "srcclk_pin" = "0"
				device generic 0 on
				end
			end
		end

		device ref pch_espi on
			chip superio/fintek/f81216e
				register "conf_entry_key" = "CONF_ENTRY_KEY_6767"

				device pnp 2e.0 on	# upper left (COM1)
					io 0x60 = 0x3f8
					irq 0x70 = 4
				end
				device pnp 2e.1 on	# lower left (COM2)
					io 0x60 = 0x2f8
					irq 0x70 = 3
				end
				device pnp 2e.2 on	# upper right (COM3)
					io 0x60 = 0x3e8
					irq 0x70 = 5
				end
				device pnp 2e.3 on	# lower right (COM4)
					io 0x60 = 0x2e8
					irq 0x70 = 7
				end
				device pnp 2e.8 off end	# WDT
				device pnp 2e.9 off end	# GPIO
			end
		end
	end
	chip drivers/crb
		device mmio 0xfed40000 on end
	end
end

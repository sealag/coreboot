CONFIG_OPTION_BACKEND_NONE=y
CONFIG_VENDOR_SEAL=y
# CONFIG_CONSOLE_SERIAL is not set
CONFIG_HAVE_IFD_BIN=y
CONFIG_WDT_ENABLE=y
CONFIG_EDK2_BOOTSPLASH_FILE="3rdparty/blobs/mainboard/seal/logo.bmp"
CONFIG_HAVE_ME_BIN=y
CONFIG_DRIVERS_EFI_VARIABLE_STORE=y
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPOSITORY="https://github.com/sealag/edk2"
CONFIG_EDK2_TAG_OR_REV="origin/seal"
CONFIG_EDK2_FOLLOW_BGRT_SPEC=y
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D NETWORK_ENABLE -D NETWORK_DRIVER_ENABLE -D NETWORK_PXE_BOOT -D NETWORK_SNP_ENABLE -D NETWORK_IP4_ENABLE -D NETWORK_VLAN_ENABLE -D NETWORK_ISCSI_ENABLE -D NETWORK_INTEL_IGC -D NETWORK_INTEL_IGB"
